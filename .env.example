# Email (Kontaktformular + Lagebild-Briefing via Resend) — server-side
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Public contact-address (ObfuscatedEmail-Component, JS-rendered, baut sich
# nach Client-Hydration zusammen — Mail steht nicht hardcoded im Source).
# Default-Fallback falls leer: info@braum.consulting
NEXT_PUBLIC_CONTACT_USER=
NEXT_PUBLIC_CONTACT_DOMAIN=

# Analytics (Umami — cookieless)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Cloudflare Turnstile — Bot-Schutz am Kontaktformular.
# Beide leer lassen → Widget aus, Formular läuft mit Honeypot + Rate-Limit.
# Keys aus Cloudflare-Dashboard → Turnstile → Site hinzufügen.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=   # Public Site-Key (Client, Widget)
TURNSTILE_SECRET_KEY=             # Secret-Key (Server, siteverify)

# Dev only — Allowed Dev-Origins fuer Next.js (Komma-Liste), optional
# DEV_ORIGINS=localhost,127.0.0.1

# ── Lagebild-Generator ────────────────────────────────────────────────────
# Public Site-URL (wird in E-Mail-Links für Briefing-Permalinks gebraucht).
# Lokal: http://localhost:3000 — prod: https://braum.consulting
NEXT_PUBLIC_SITE_URL=

# OpenRouter — LLM-Provider für Lagebild-Briefing-Generierung
# Key auf openrouter.ai → API Keys erstellen
OPENROUTER_API_KEY=
# Modell-Slug: moonshotai/kimi-k2-0905 (default), deepseek/deepseek-chat-v3.1,
# anthropic/claude-sonnet-4.5 (teurer aber best für Stefan-Voice).
OPENROUTER_MODEL=moonshotai/kimi-k2-0905

# Notion CRM — Lead-Persistierung in "Agency Companies" Data-Source
# Internal Integration auf notion.so/my-integrations anlegen,
# Integration der Sales-CRM-Page hinzufügen (Connections),
# Capabilities: Read/Update/Insert content.
NOTION_TOKEN=
# Data-Source-ID der "Agency Companies" Datasource (NICHT die Database-ID).
NOTION_LEADS_DATA_SOURCE_ID=

# Cal.com Self-Hosted — Termin-Buchung
# Event-URL des "Lagebild-Gespräch"-Event-Types
# Beispiel: https://cal.braum.consulting/stefan/lagebild
CAL_EVENT_URL=
# Webhook-Secret (in Cal.com → Settings → Webhooks generiert)
CAL_WEBHOOK_SECRET=
